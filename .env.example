# Runtime identity
TACTIQO_APP_NAME=Tactiqo AI Operations Platform
TACTIQO_APP_VERSION=0.1.0
TACTIQO_ENVIRONMENT=local
TACTIQO_AGENT_TIMEOUT_SECONDS=300
TACTIQO_LOG_LEVEL=INFO
# Optional bearer token for /internal/metrics in non-local deployments. Keep it secret.
# Optional: the local Compose stack generates a random scrape token in a private Docker volume.
# Set this only when you intentionally supply/manage the shared token yourself.
# TACTIQO_METRICS_AUTH_TOKEN=generate-a-long-random-value
TACTIQO_API_HOST=0.0.0.0
TACTIQO_API_PORT=8000
TACTIQO_READINESS_TIMEOUT_SECONDS=3.0

# Local development infrastructure only. Replace values before any shared use.
TACTIQO_DATABASE_URL=postgresql+asyncpg://tactiqo_app:change-me@postgres:5432/tactiqo
TACTIQO_REDIS_URL=redis://redis:6379/0
TACTIQO_RABBITMQ_URL=amqp://tactiqo_app:change-me@rabbitmq:5672/
TACTIQO_MINIO_ENDPOINT=http://minio:9000
TACTIQO_MINIO_ACCESS_KEY=change-me
TACTIQO_MINIO_SECRET_KEY=change-me
TACTIQO_MINIO_BUCKET=tactiqo-knowledge

# F1 agent runtime. Deterministic is an explicit local/demo provider.
TACTIQO_MODEL_PROVIDER=ai_bank
TACTIQO_OPENAI_API_KEY=
TACTIQO_OPENAI_MODEL=gpt-5.6-sol
TACTIQO_OPENAI_REASONING_EFFORT=low
TACTIQO_MCP_ENABLED=true
TACTIQO_MCP_DEMO_URL=http://mcp-demo:8100/mcp

# Compose-only bootstrap values. These are examples, never production secrets.
POSTGRES_DB=tactiqo
POSTGRES_USER=tactiqo_app
POSTGRES_PASSWORD=change-me
RABBITMQ_DEFAULT_USER=tactiqo_app
RABBITMQ_DEFAULT_PASS=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Browser-visible API origin for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:18000

# MCP registry. Keep real credentials in .env only; never commit them.
TACTIQO_MCP_ENABLED=true
TACTIQO_MCP_DEMO_ENABLED=true
TACTIQO_MCP_JIRA_ENABLED=false
TACTIQO_MCP_JIRA_URL=https://mcp.atlassian.com/v2/mcp?tools=all
TACTIQO_MCP_JIRA_AUTHORIZATION=
TACTIQO_MCP_JIRA_OAUTH_STORAGE=
TACTIQO_MCP_SLACK_ENABLED=false
TACTIQO_MCP_SLACK_URL=
TACTIQO_MCP_SLACK_AUTHORIZATION=
TACTIQO_INTEGRATION_CONNECTIONS_ENABLED=false
TACTIQO_CREDENTIAL_ENCRYPTION_KEY=
TACTIQO_OAUTH_PUBLIC_API_BASE_URL=http://127.0.0.1:18000
TACTIQO_OAUTH_WEB_BASE_URL=http://127.0.0.1:13000
TACTIQO_SLACK_OAUTH_CLIENT_ID=
TACTIQO_SLACK_OAUTH_CLIENT_SECRET=

# Isolated host bindings. Container-to-container ports remain unchanged.
TACTIQO_POSTGRES_HOST_PORT=15432
TACTIQO_REDIS_HOST_PORT=16379
TACTIQO_RABBITMQ_HOST_PORT=15673
TACTIQO_RABBITMQ_MANAGEMENT_HOST_PORT=25673
TACTIQO_MINIO_HOST_PORT=19000
TACTIQO_MINIO_CONSOLE_HOST_PORT=19001
TACTIQO_API_HOST_PORT=18000
TACTIQO_WEB_HOST_PORT=13000
TACTIQO_PROMETHEUS_HOST_PORT=19091
TACTIQO_GRAFANA_HOST_PORT=13001
TACTIQO_GRAFANA_HOST_PORT=13001

# Local lifecycle commands reject staging/production and destructive commands
# additionally require an explicit confirmation value.
TACTIQO_DEV_TENANT_ID=dev-tactiqo
TACTIQO_BACKUP_DIRECTORY=.local/backups

# Production identity: generic OIDC Authorization Code + PKCE.
TACTIQO_OIDC_ENABLED=false
TACTIQO_OIDC_ISSUER=
TACTIQO_OIDC_AUDIENCE=
TACTIQO_OIDC_CLIENT_ID=
TACTIQO_OIDC_CLIENT_SECRET=
TACTIQO_OIDC_AUTHORIZATION_ENDPOINT=
TACTIQO_OIDC_TOKEN_ENDPOINT=
TACTIQO_OIDC_JWKS_URI=
TACTIQO_OIDC_STATE_SIGNING_KEY=
TACTIQO_OIDC_REDIRECT_URI=http://127.0.0.1:18000/api/v1/auth/callback
TACTIQO_OIDC_SESSION_COOKIE_NAME=tactiqo_session
TACTIQO_OIDC_SESSION_TTL_SECONDS=3600
TACTIQO_WORK_ENVELOPE_SIGNING_KEY=replace-with-independent-32-character-minimum-key

# Production RAG is intentionally deferred until the Jira and Slack MCP flow
# passes its functional, authorization, approval, and audit gates.
